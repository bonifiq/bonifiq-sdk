<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 ou mais novo: pedida por BonifiQPush.requestPermission(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Recebe as mensagens e o token do FCM. O Android entrega a MESSAGING_EVENT a um serviço só: se o app já
             tem o próprio FirebaseMessagingService, ele remove este (tools:node="remove") e repassa as chamadas a
             BonifiQPush.onMessageReceived(message) e BonifiQPush.onNewToken(token). -->
        <service
            android:name="br.com.bonifiq.sdk.push.BonifiQMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Conduz o pedido de permissão de notificação (invisível). -->
        <activity
            android:name="br.com.bonifiq.sdk.push.PushPermissionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Guarda o contexto do app ao iniciar, para o BonifiQPush(bonifiq) funcionar sem receber Context. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="br.com.bonifiq.sdk.push.PushInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
